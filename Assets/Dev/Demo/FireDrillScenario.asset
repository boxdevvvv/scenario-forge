        title: Briefing
        instruction: Fire safety drill. There is a fire in the room. Press Enter (or Continue) to start.
        timeoutSeconds: 0
        onFailure: 0
        maxRetries: 0
        requireConfirmation: 1
        confirmSignal: confirm
        autoAdvanceSeconds: 0
    - rid: 8825433672651112515
