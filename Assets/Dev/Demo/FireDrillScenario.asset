        title: Walk to the extinguisher
        instruction: Walk to the red extinguisher with WASD. You have 30 seconds.
        timeoutSeconds: 30
        onFailure: 2
        maxRetries: 2
        actorTargetId: player
        destinationTargetId: extinguisher
        radius: 1.5
