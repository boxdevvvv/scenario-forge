        title: Walk to the extinguisher
        instruction: Fire! Walk to the red extinguisher (highlighted in yellow) with WASD. You have 30 seconds.
        timeoutSeconds: 30
        onFailure: 2
        maxRetries: 2
        actorTargetId: player
        destinationTargetId: extinguisher
        radius: 1.5
